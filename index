<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SIR대회 제출 현황</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
:root{--t0:#2f6fa8;--t0b:#e6f0f9;--t1:#7a4ea3;--t1b:#efe8f7;--t2:#2f7d6b;--t2b:#e3f3ef;--o:#E8590C;--ink:#25221f;--mut:#6f665d;--line:#e8e1d8;--soft:#faf7f3;--ok-b:#dcefd6;--ok-t:#2b6428;--fix-b:#ffe49a;--fix-t:#5f4600;--no-b:#eeebe7;--no-t:#6f665d;--late-b:#f6cccc;--late-t:#8a2b2b;--due:#f6cccc;--due-t:#8a2b2b;--run:#fddcc4;--run-t:#85400f;--ev:#fff0bd;--ev-t:#5f4a00}
*{box-sizing:border-box}
body{margin:0;font-family:Pretendard,-apple-system,"Noto Sans KR",sans-serif;color:var(--ink);background:#fff;line-height:1.6;-webkit-text-size-adjust:100%}
main{max-width:980px;margin:0 auto;padding:28px 20px 64px}
h1{font-size:26px;font-weight:700;margin:0;letter-spacing:-.01em}
h2{font-size:18px;font-weight:700;margin:0 0 12px}
section{margin-top:40px}
.top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;flex-wrap:wrap;padding-bottom:14px;border-bottom:2px solid var(--o)}
.upd{font-size:13px;color:var(--mut)}
.notice{margin-top:12px;padding:8px 12px;background:var(--ev);color:var(--ev-t);font-size:13px;border-radius:6px}
.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:28px;margin-top:24px;align-items:end}
.next small,.prog small{display:block;font-size:13px;color:var(--mut)}
.next .dd{font-size:44px;font-weight:700;color:var(--o);line-height:1.1;letter-spacing:-.02em}
.next .nm{font-size:17px;font-weight:600;margin-left:8px}
.bar{height:12px;background:var(--no-b);border-radius:6px;overflow:hidden;margin:8px 0 4px}
.bar i{display:block;height:100%;background:var(--o)}
.prog b{font-size:22px}
.tabs{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap;align-items:center}
button{font:inherit;font-size:14px;padding:6px 14px;border:1px solid var(--line);background:#fff;color:var(--ink);border-radius:6px;cursor:pointer}
button[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
:focus-visible{outline:2px solid var(--o);outline-offset:2px}
.legend{margin-left:auto;display:flex;gap:12px;font-size:12px;color:var(--mut)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px;vertical-align:-1px}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
.cal>div{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:4px;min-height:86px}
.cal .hd{min-height:0;text-align:center;font-size:13px;font-weight:600;background:var(--soft);padding:6px 0}
.cal .n{font-size:12px;color:var(--ink)}.cal .out .n{color:#b5aca2}
.cal .tod .n{display:inline-block;min-width:22px;text-align:center;background:var(--o);color:#fff;border-radius:11px;font-weight:600}
.chip{margin-top:3px;padding:2px 5px;border-radius:4px;font-size:11px;line-height:1.35;word-break:keep-all}
.chip.due{background:var(--due);color:var(--due-t)}.chip.run{background:var(--run);color:var(--run-t)}.chip.ev{background:var(--ev);color:var(--ev-t)}
.items{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}
.item{border:1px solid var(--line);border-radius:10px;padding:14px 16px}
.item h3{margin:0;font-size:16px}
.item .dl{font-size:13px;color:var(--mut);margin:2px 0 8px}
.item .dl b{color:var(--o)}
.item p{margin:0 0 6px;font-size:14px}
.item .g{font-size:13px;color:var(--mut)}
.item a{display:inline-block;margin-top:8px;padding:6px 12px;background:var(--o);color:#fff;border-radius:6px;font-size:13px;text-decoration:none;font-weight:600}
.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px}
table{border-collapse:collapse;width:100%;min-width:640px;font-size:14px}
th,td{padding:10px 12px;text-align:center;border-bottom:1px solid var(--line)}
thead th{background:var(--soft);font-weight:600;vertical-align:bottom}
thead th small{display:block;font-weight:400;font-size:12px;color:var(--mut)}
th.l,td.l{text-align:left;position:sticky;left:0;background:#fff;min-width:150px}
thead th.l{background:var(--soft)}
tr.trk td{text-align:left;font-weight:600;font-size:13px}
tr.trk td span{font-weight:400;margin-left:6px}
tr.t0 td.l{background:var(--t0b);box-shadow:inset 5px 0 0 var(--t0)}
tr.t1 td.l{background:var(--t1b);box-shadow:inset 5px 0 0 var(--t1)}
tr.t2 td.l{background:var(--t2b);box-shadow:inset 5px 0 0 var(--t2)}
tr.trk.t0 td{background:var(--t0);color:#fff}
tr.trk.t1 td{background:var(--t1);color:#fff}
tr.trk.t2 td{background:var(--t2);color:#fff}
tr.trk td.l{box-shadow:none}
td.l{padding-left:18px}
tbody tr:last-child td{border-bottom:0}
.st{display:inline-block;min-width:68px;padding:3px 10px;border-radius:12px;font-size:12.5px;font-weight:600}
.st.ok{background:var(--ok-b);color:var(--ok-t)}.st.fix{background:var(--fix-b);color:var(--fix-t)}.st.no{background:var(--no-b);color:var(--no-t)}.st.late{background:var(--late-b);color:var(--late-t)}
.cnt{font-size:13px;color:var(--mut);white-space:nowrap}
.err{padding:20px;text-align:center;color:var(--late-t)}
@media(max-width:640px){.hero{grid-template-columns:1fr}.cal>div{min-height:64px;padding:2px}.chip{font-size:10px;padding:1px 3px}h1{font-size:22px}.next .dd{font-size:38px}}
@media(prefers-reduced-motion:no-preference){.bar i{transition:width .5s ease-out}}
</style>
</head>
<body>
<main>
<div class="top"><h1>SIR대회 제출 현황</h1><span class="upd" id="upd"></span></div>
<div id="app"><p class="upd" style="margin-top:24px">불러오는 중…</p></div>
</main>
<script>
var API_URL = 'https://script.google.com/macros/s/AKfycbzV5OHTi2kdiHn8oGFa4a2v46hmgwFsbMY6mLgx97G-La__TOkmd6kX7p5xxeN8EFfC/exec';

var DEMO = {updatedAt:new Date().toISOString(),
schedule:[{"start": "2026-10-15", "end": "2026-10-15", "kind": "행사", "title": "온라인 OT"}, {"start": "2026-10-31", "end": "2026-10-31", "kind": "마감", "title": "교통/숙식/동행 신청 마감"}, {"start": "2026-11-02", "end": "2026-11-02", "kind": "마감", "title": "소개자료 제출 마감"}, {"start": "2026-11-09", "end": "2026-11-09", "kind": "마감", "title": "1차 피칭자료 제출 마감"}, {"start": "2026-11-11", "end": "2026-11-15", "kind": "진행", "title": "영상 콘텐츠 촬영"}, {"start": "2026-11-16", "end": "2026-11-20", "kind": "진행", "title": "1:1 심층 피드백(온라인)"}, {"start": "2026-11-22", "end": "2026-11-24", "kind": "진행", "title": "영상 콘텐츠 촬영"}, {"start": "2026-12-04", "end": "2026-12-04", "kind": "마감", "title": "최종 피칭자료 제출"}, {"start": "2026-12-09", "end": "2026-12-09", "kind": "행사", "title": "SIR대회 본선"}, {"start": "2026-12-10", "end": "2026-12-10", "kind": "행사", "title": "SDC 네트워킹데이"}],
items:[{"name": "교통/숙식/동행 신청", "deadline": "2026-10-31", "method": "구글 신청폼", "link": "https://docs.google.com/forms/d/e/1FAIpQLScQD3uIPAEKltwY6KgPpaAGyZjw3BKSzmVIGO8dmG5amlazEg/viewform?usp=dialog", "guide": "무대에 오르는 소셜디자이너 1인에게 왕복 교통비(실비)와 숙식을 지원합니다.\n- 동료 1인에 한하여 숙식을 지원합니다. (교통비는 지원이 어렵습니다)\n- 동료 1인 이상일 경우에는 지원이 어렵습니다. (참여는 가능하나 별도 비용 지출 필요)"}, {"name": "소개자료", "deadline": "2026-11-02", "method": "구글 드라이브 팀명 폴더에 제출", "link": "https://drive.google.com/drive/folders/1qPv-BUFA0taJ_lYmflc1qRX6omHvGeUy?usp=sharing", "guide": "사진/영상 등 SIR대회에서 팀 소개 자료로 활용될 활동 자료를 제출해주세요.\n- 발표자(대표자) 프로필 사진\n- 활동 사진 10장 내외 / 활동 영상 3개 내외"}, {"name": "1차 피칭자료", "deadline": "2026-11-09", "method": "최나현 연구원 (trami@makehope.org) 이메일 제출", "link": "", "guide": "1차 자료 제출 접수 순으로 1:1 피드백 가능 시간을 선택할 수 있도록 선택지를 드립니다.\n- 발표 자료 PPT와 대본을 함께 제출해주세요.\n- 제출된 자료는 내외부 검토 후, 11/16(월)~11/20(금) 중 1:1 피드백을 진행합니다."}, {"name": "최종 피칭자료", "deadline": "2026-12-04", "method": "최나현 연구원 (trami@makehope.org) 이메일 제출", "link": "", "guide": "최종 제출 마감 후 PPT 교체, 변경 불가합니다. (특히 당일)"}],
teams:[{"id": "청1", "track": "청년", "name": "제주농업인플랫폼", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "청2", "track": "청년", "name": "(주)재작소", "status": {"교통/숙식/동행 신청": "미제출", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "청3", "track": "청년", "name": "청년채움", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "보완요청", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "청4", "track": "청년", "name": "터치제주", "status": {"교통/숙식/동행 신청": "미제출", "소개자료": "미제출", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "청5", "track": "청년", "name": "52헤르츠고래들", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "지1", "track": "지역소멸대응", "name": "(주)보탬플러스", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "지2", "track": "지역소멸대응", "name": "팜앤디협동조합", "status": {"교통/숙식/동행 신청": "미제출", "소개자료": "미제출", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "지3", "track": "지역소멸대응", "name": "사회적협동조합 바람개비마을", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "지4", "track": "지역소멸대응", "name": "라이킹", "status": {"교통/숙식/동행 신청": "미제출", "소개자료": "제출완료", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}, {"id": "지5", "track": "지역소멸대응", "name": "(주)다로리인", "status": {"교통/숙식/동행 신청": "제출완료", "소개자료": "보완요청", "1차 피칭자료": "미제출", "최종 피칭자료": "미제출"}}]};

var DAY = 864e5, WD = '일월화수목금토';
var today = new Date(); today.setHours(0,0,0,0);
var data = null, month = null;

function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function pd(s){var a=s.split('-');return new Date(+a[0],+a[1]-1,+a[2]);}
function ds(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
function dday(s){var n=Math.round((pd(s)-today)/DAY);return n===0?'D-Day':n>0?'D-'+n:'D+'+(-n);}
function md(s){var d=pd(s);return (d.getMonth()+1)+'/'+d.getDate()+'('+WD[d.getDay()]+')';}
var TODAY = ds(today);
var KC = {'마감':'due','진행':'run','행사':'ev'};
function isDone(s){return s==='제출완료'||s==='제출';}

function load(){
  if(!API_URL){render(DEMO,true);return;}
  fetch(API_URL).then(function(r){return r.json();}).then(function(j){if(j.error)throw new Error(j.error);render(j,false);}).catch(function(){
    document.getElementById('app').innerHTML='<p class="err">현황을 불러오지 못했어요. 잠시 후 새로고침해 주세요.</p>';
  });
}

function render(d,demo){
  data=d;
  var months=[],s=d.schedule.map(function(e){return e.start.slice(0,7);}).concat(d.schedule.map(function(e){return e.end.slice(0,7);}));
  s.forEach(function(m){if(months.indexOf(m)<0)months.push(m);});
  months.sort();
  if(!month||months.indexOf(month)<0)month=months.indexOf(TODAY.slice(0,7))>=0?TODAY.slice(0,7):months[0];
  data.months=months;
  var upd=d.updatedAt?new Date(d.updatedAt):null;
  document.getElementById('upd').textContent=upd?'업데이트 '+(upd.getMonth()+1)+'/'+upd.getDate()+' '+String(upd.getHours()).padStart(2,'0')+':'+String(upd.getMinutes()).padStart(2,'0'):'';
  var h='';
  if(demo)h+='<div class="notice">샘플 데이터로 보여주는 미리보기예요. 코드 상단의 API_URL에 웹 앱 주소를 넣으면 실제 시트 내용이 나와요.</div>';
  h+=hero();
  h+='<section><h2>팀별 제출 현황</h2>'+matrix()+'</section>';
  h+='<section><h2>공통 일정</h2><div id="cal"></div></section>';
  h+='<section><h2>제출 항목 안내</h2>'+items()+'</section>';
  document.getElementById('app').innerHTML=h;
  drawCal();
}

function itemDone(name){var n=0;data.teams.forEach(function(t){if(isDone(t.status[name]))n++;});return n;}

function hero(){
  var nx=data.items.filter(function(i){return i.deadline>=TODAY;}).sort(function(a,b){return a.deadline<b.deadline?-1:1;})[0];
  if(!nx)return '<div class="hero"><div class="next"><small>다음 마감</small><span class="nm">모든 제출이 마감됐어요</span></div><div></div></div>';
  var N=data.teams.length,done=itemDone(nx.name),pct=N?Math.round(done/N*100):0;
  var left='<small>다음 마감 '+md(nx.deadline)+'</small><span class="dd">'+dday(nx.deadline)+'</span><span class="nm">'+esc(nx.name)+'</span>';
  var right='<small>'+esc(nx.name)+' 제출 현황</small><div class="bar" role="progressbar" aria-valuenow="'+pct+'" aria-valuemin="0" aria-valuemax="100"><i style="width:'+pct+'%"></i></div><b>'+pct+'%</b> <span class="cnt">'+done+' / '+N+'팀 제출 완료</span>';
  return '<div class="hero"><div class="next">'+left+'</div><div class="prog">'+right+'</div></div>';
}

function drawCal(){
  var tabs='<div class="tabs">';
  data.months.forEach(function(m){tabs+='<button data-m="'+m+'" aria-pressed="'+(m===month)+'">'+(+m.slice(5))+'월</button>';});
  tabs+='<div class="legend"><span><i style="background:var(--due)"></i>마감</span><span><i style="background:var(--run)"></i>진행</span><span><i style="background:var(--ev)"></i>행사</span></div></div>';
  var y=+month.slice(0,4),m=+month.slice(5);
  var first=new Date(y,m-1,1),wd=(first.getDay()+6)%7,last=new Date(y,m,0).getDate(),total=Math.ceil((wd+last)/7)*7;
  var g='<div class="cal" role="grid">';
  '월화수목금토일'.split('').forEach(function(n){g+='<div class="hd">'+n+'</div>';});
  for(var i=0;i<total;i++){
    var d=new Date(y,m-1,1-wd+i),k=ds(d),out=d.getMonth()!==m-1;
    var cls=(out?'out ':'')+(k===TODAY?'tod':'');
    g+='<div class="'+cls+'"><span class="n">'+d.getDate()+'</span>';
    data.schedule.forEach(function(e){if(e.start<=k&&k<=e.end)g+='<div class="chip '+(KC[e.kind]||'ev')+'" title="'+esc(e.title)+'">'+esc(e.title)+'</div>';});
    g+='</div>';
  }
  document.getElementById('cal').innerHTML=tabs+g+'</div>';
  document.querySelectorAll('#cal button').forEach(function(b){b.onclick=function(){month=b.getAttribute('data-m');drawCal();};});
}

function items(){
  var h='<div class="items">';
  data.items.slice().sort(function(a,b){return a.deadline<b.deadline?-1:1;}).forEach(function(i){
    h+='<article class="item"><h3>'+esc(i.name)+'</h3><div class="dl">마감 '+md(i.deadline)+' · <b>'+dday(i.deadline)+'</b></div><p>제출 방법: '+esc(i.method||'안내 예정')+'</p>';
    if(i.guide)h+='<p class="g">'+esc(i.guide).replace(/\n/g,'<br>')+'</p>';
    if(/^https?:\/\//.test(i.link||''))h+='<a href="'+esc(i.link)+'" target="_blank" rel="noopener">제출하러 가기</a>';
    h+='</article>';
  });
  return h+'</div>';
}

function matrix(){
  var its=data.items.slice().sort(function(a,b){return a.deadline<b.deadline?-1:1;});
  var h='<div class="scroll"><table><thead><tr><th class="l">팀</th>';
  its.forEach(function(i){h+='<th>'+esc(i.name)+'<small>'+md(i.deadline)+' '+dday(i.deadline)+'</small><small>'+itemDone(i.name)+' / '+data.teams.length+'팀 제출</small></th>';});
  h+='<th>진행</th></tr></thead><tbody>';
  var cur=null,tk=[],cn={};
  data.teams.forEach(function(t){if(tk.indexOf(t.track)<0)tk.push(t.track);cn[t.track]=(cn[t.track]||0)+1;});
  data.teams.forEach(function(t){
    var k=tk.indexOf(t.track)%3;
    if(t.track!==cur){cur=t.track;h+='<tr class="trk t'+k+'"><td colspan="'+(its.length+2)+'">'+esc(cur)+'<span>'+cn[cur]+'팀</span></td></tr>';}
    var n=0;
    h+='<tr class="t'+k+'"><td class="l">'+esc(t.name)+'</td>';
    its.forEach(function(i){
      var s=t.status[i.name]||'미제출',c='no';
      if(isDone(s)){c='ok';n++;s='제출완료';}else if(s==='보완요청')c='fix';else if(i.deadline<TODAY)c='late';
      h+='<td><span class="st '+c+'">'+esc(c==='late'?'미제출':s)+'</span></td>';
    });
    h+='<td class="cnt">'+n+' / '+its.length+'</td></tr>';
  });
  return h+'</tbody></table></div>';
}

load();
setInterval(load,300000);
</script>
